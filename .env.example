# Environment for docker-compose / Coolify.
# Copy to .env and fill in the secrets before deploying.

# --- Database ---
POSTGRES_USER=abacus
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=abacus

# --- Backend ---
ENVIRONMENT=production
# Generate, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_this_to_a_secure_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Public URL(s) of the app, comma-separated (used for CORS and CSRF checks).
CORS_ORIGINS=https://abacus.example.com
APP_URL=https://abacus.example.com

AUTH_RATE_LIMIT=5/minute
LOG_RETENTION_DAYS=90
SQL_ECHO=false

# Logs page (HTTP Basic) credentials.
LOGS_USER=admin
LOGS_PASS=change_this

# --- SMTP (password reset emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
