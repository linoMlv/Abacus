# Preconfigured LOCAL prod-simulation environment for Abacus.
# Used by ./scripts/run-test.sh (docker compose project "abacus-test").
#
# ⚠️  LOCAL / THROWAWAY ONLY — every value here is public and non-secret.
#     NEVER deploy with this file. Real production uses .env (from .env.example)
#     with generated secrets and ENVIRONMENT=production.
#
# This env mirrors production (same image, migrations, Postgres, security
# headers, CSP, argon2, origin/CSRF check) with exactly two relaxations so the
# app is reachable over plain http://localhost: ENVIRONMENT=staging disables the
# Secure-cookie flag and HSTS (both require HTTPS and would break local login).

# --- Database ---
POSTGRES_USER=abacus
POSTGRES_PASSWORD=abacus
POSTGRES_DB=abacus

# --- Backend ---
# "staging" = prod-like, but cookies are sent over http and HSTS is not emitted.
ENVIRONMENT=staging
# Fixed local-only key (NOT a secret). Prod must generate its own.
SECRET_KEY=local-test-secret-not-for-production-0123456789abcdef
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Browser origin of the app, used for CORS and the CSRF origin check.
CORS_ORIGINS=http://localhost:8000
APP_URL=http://localhost:8000

# Relaxed so repeated logins while testing don't hit the limiter.
AUTH_RATE_LIMIT=50/minute
LOG_RETENTION_DAYS=90
SQL_ECHO=false

# Logs page (HTTP Basic) — http://localhost:8000/api/logs
LOGS_USER=admin
LOGS_PASS=admin

# --- SMTP (left empty: invitation/reset links are logged instead of sent) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
