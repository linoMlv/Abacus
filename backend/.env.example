# Use "production" in deployment: it enforces a non-default SECRET_KEY
# and secure cookies.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://user:password@host:5432/abacus
# Set SQL_ECHO=true only for debugging; it logs every SQL statement.
SQL_ECHO=false
SECRET_KEY=change_this_to_a_secure_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logs page credentials
LOGS_USER=admin
LOGS_PASS=change_this
# Delete server logs older than this many days (0 disables purging).
LOG_RETENTION_DAYS=90

# Comma-separated browser origins allowed for CORS and CSRF origin checks.
# In production set this to your public URL, e.g. https://abacus.example.com
CORS_ORIGINS=http://localhost:9873

# Authentication rate limit (slowapi syntax), e.g. 5/minute.
AUTH_RATE_LIMIT=5/minute

# SMTP (for password reset emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@example.com
APP_URL=http://localhost:9873
