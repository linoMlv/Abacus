# Use "production" in deployment: it enforces a non-default SECRET_KEY
# and secure cookies.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://user:password@host:5432/abacus
# Set SQL_ECHO=true only for debugging; it logs every SQL statement.
SQL_ECHO=false
SECRET_KEY=change_this_to_a_secure_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logs page credentials
LOGS_USER=admin
LOGS_PASS=change_this

# SMTP (for password reset emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@example.com
APP_URL=http://localhost:9873
